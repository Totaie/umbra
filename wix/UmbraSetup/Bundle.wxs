<!-- This block is autogenerated using scripts\update-msvcredist.ps1 -->
<?define VCREDIST_VER = "14.51.36247.0" ?>
<?define VCREDIST_X64_SIZE = "18731856" ?>
<?define VCREDIST_X64_SHA512 = "C42C82CFD5EAA2165B600F6109CB14FF4308CDF4CFF656A1375B4A933F1630BFE54C99C4D0FB9ED3BEA4DC4E4FDAA3DB8E7C58356CCA07C2954F4C297757D62D" ?>
<?define VCREDIST_X64_URL = "https://download.visualstudio.microsoft.com/download/pr/ebdab8e5-1d7b-4d9f-a11b-cbb1720c3b12/843068991DAAA1F73AD9F6239BCE4D0F6A07A51F18C37EA2A867E9BECA71295C/VC_redist.x64.exe" ?>
<?define VCREDIST_X64_UPGRADE_CODE = "36F68A90-239C-34DF-B58C-64B30153CE35" ?>
<?define VCREDIST_ARM64_SIZE = "11870816" ?>
<?define VCREDIST_ARM64_SHA512 = "1B6B606B92002C6F31C0DBE1AF412D313BF9D651ABB5A4C4457E4EC17E711BFF044506F8FDB9F29639FCA7742DF4775E4B1BEA1FB438DF456A8446DA5ED658AB" ?>
<?define VCREDIST_ARM64_URL = "https://download.visualstudio.microsoft.com/download/pr/ddfd326a-05c1-4646-9cf7-9fbc5206a9e8/B70EF586669A620A0A30A1156969C05C6A3831DC8F8BC992DA75779D2A92F944/VC_redist.arm64.exe" ?>
<?define VCREDIST_ARM64_UPGRADE_CODE = "DC9BAE42-810B-423A-9E25-E4073F1C7B00" ?>

<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs" xmlns:bal="http://wixtoolset.org/schemas/v4/wxs/bal" xmlns:util="http://wixtoolset.org/schemas/v4/wxs/util">

  <!-- NB: UpgradeCode is deliberately different from Moonlight's so this bundle does
       not upgrade over an existing Moonlight installation. -->
  <Bundle Name="Umbra Remote Desktop Client"
          Version="!(bind.PackageVersion.Umbra_x64)"
          Manufacturer="Umbra Project"
          UpgradeCode="0c9e0b84-72fd-4c6a-a9bf-53dab844e85d"
          HelpUrl="https://github.com/Totaie/umbra"
          UpdateUrl="https://github.com/Totaie/umbra/releases"
          DisableModify="yes"
          IconSourceFile="..\..\app\moonlight.ico">

    <bal:Condition Message="Umbra requires Windows 10 or later." Condition="VersionNT &gt;= v10.0" />
    <bal:Condition Message="Umbra requires a 64-bit version of Windows." Condition="NativeMachine &lt;&gt; 332" />

    <Variable Name="InstallFolder" Type="formatted" Value="[ProgramFiles6432Folder]Umbra" />

    <!-- Define "Add desktop shortcut" -checkbox's state by defining a variable
         which has same name as the checkbox has. Value 1 means that checkbox
         is checked, 0 means that is unchecked-->
    <!-- Set checkbox's state as checked by default -->
    <Variable Name="AddDesktopShortcutCheckbox" Type="numeric" Value="1" />
    <!-- Get checkbox's state from registry if present. The registry value
         "DesktopShortcutInstallState" is set in Product.wxs. -->
    <util:RegistrySearch Variable="HasDesktopShortcutInstallStateRegKey" Root="HKCU" Key="Software\Umbra Project" Value="DesktopShortcutInstallState" Result="exists" />
    <util:RegistrySearch Variable="AddDesktopShortcutCheckbox" Root="HKCU" Key="Software\Umbra Project" Value="DesktopShortcutInstallState" Condition="HasDesktopShortcutInstallStateRegKey" />

    <!-- Whether to also install the Umbra host, so this PC can be streamed *from*
         as well as *to*. Checked by default: Umbra is meant to do both out of the box.
         The host is a much heavier install than the client (a background service, a
         virtual display driver and firewall rules), so it stays a visible, declinable
         choice rather than something that happens silently. -->
    <Variable Name="InstallHostCheckbox" Type="numeric" Value="1" />

    <!-- Don't offer to install a host that's already present. Vibepollo and its
         Apollo/Sunshine ancestors register their service under this key. -->
    <util:RegistrySearch Variable="HostAlreadyInstalled"
                         Root="HKLM"
                         Key="SYSTEM\CurrentControlSet\Services\SunshineService"
                         Result="exists" />

    <util:ProductSearch Id="VCREDIST_14_x64"
                        UpgradeCode="$(var.VCREDIST_X64_UPGRADE_CODE)"
                        Result="version"
                        Variable="VCREDIST_14_x64" />

    <util:ProductSearch Id="VCREDIST_14_ARM64"
                        UpgradeCode="$(var.VCREDIST_ARM64_UPGRADE_CODE)"
                        Result="version"
                        Variable="VCREDIST_14_ARM64" />

    <BootstrapperApplication>
      <bal:WixStandardBootstrapperApplication ShowVersion="yes"
                                              LicenseFile="license.rtf"
                                              LogoFile="..\..\app\moonlight_wix.png"
                                              LaunchTarget="[InstallFolder]\Umbra.exe"
                                              ThemeFile="RtfTheme.xml"
                                              Theme="rtfLicense" />
      <Payload Name="Umbra.ico" SourceFile="..\..\app\moonlight.ico" Compressed="yes" />
    </BootstrapperApplication>

    <Chain>
      <ExePackage Cache="remove"
                  PerMachine="yes"
                  Permanent="yes"
                  Vital="yes"
                  InstallCondition="(VersionNT64 AND NOT NativeMachine) OR (NativeMachine = 34404)"
                  DetectCondition="VCREDIST_14_x64 &gt;= v$(var.VCREDIST_VER)"
                  InstallArguments="/install /quiet /norestart">

        <ExePackagePayload Description="Microsoft Visual C++ 2015-2022 Redistributable - x64"
                           ProductName="Microsoft Visual C++ 2015-2022 Redistributable - x64"
                           Size="$(var.VCREDIST_X64_SIZE)"
                           Version="$(var.VCREDIST_VER)"
                           Hash="$(var.VCREDIST_X64_SHA512)"
                           Name="VC_redist.x64.exe"
                           DownloadUrl="$(var.VCREDIST_X64_URL)" />

        <!-- Newer version installed is fine -->
        <ExitCode Value="1638" Behavior="success" />
      </ExePackage>

      <ExePackage Cache="remove"
                  PerMachine="yes"
                  Permanent="yes"
                  Vital="yes"
                  InstallCondition="NativeMachine = 43620"
                  DetectCondition="VCREDIST_14_ARM64 &gt;= v$(var.VCREDIST_VER)"
                  InstallArguments="/install /quiet /norestart">

        <ExePackagePayload Description="Microsoft Visual C++ 2015-2022 Redistributable - ARM64"
                           ProductName="Microsoft Visual C++ 2015-2022 Redistributable - ARM64"
                           Size="$(var.VCREDIST_ARM64_SIZE)"
                           Version="$(var.VCREDIST_VER)"
                           Hash="$(var.VCREDIST_ARM64_SHA512)"
                           Name="VC_redist.arm64.exe"
                           DownloadUrl="$(var.VCREDIST_ARM64_URL)" />

        <!-- Newer version installed is fine -->
        <ExitCode Value="1638" Behavior="success" />
      </ExePackage>

      <MsiPackage Id="Umbra_x64"
                  SourceFile="$(env.BUILD_ROOT)\build-x64-$(env.BUILD_CONFIG)\Umbra.msi"
                  Name="Umbra_x64.msi"
                  InstallCondition="(VersionNT64 AND NOT NativeMachine) OR (NativeMachine = 34404)"
                  Vital="yes">
        <MsiProperty Name="INSTALLFOLDER" Value="[InstallFolder]" />
        <MsiProperty Name="ADDDESKTOPSHORTCUT" Value="[AddDesktopShortcutCheckbox]" />
      </MsiPackage>

      <!-- Set UMBRA_SKIP_ARM64 to build an x64-only bundle. A full release should
           always ship both, but requiring an ARM64 cross-build just to test the
           bundle locally makes the host opt-in below impossible to verify. -->
      <?ifndef env.UMBRA_SKIP_ARM64 ?>
      <MsiPackage Id="Umbra_arm64"
                  SourceFile="$(env.BUILD_ROOT)\build-arm64-$(env.BUILD_CONFIG)\Umbra.msi"
                  Name="Umbra_arm64.msi"
                  InstallCondition="NativeMachine = 43620"
                  Vital="yes">
        <MsiProperty Name="INSTALLFOLDER" Value="[InstallFolder]" />
        <MsiProperty Name="ADDDESKTOPSHORTCUT" Value="[AddDesktopShortcutCheckbox]" />
      </MsiPackage>
      <?endif?>

      <!-- The Umbra host, so one install can both stream to and be streamed from.
           Fetched at build time by scripts\fetch-host.ps1 rather than pinned to a
           DownloadUrl with a baked-in hash, so host updates don't require editing
           this file. Not Vital: a host failure shouldn't fail the client install the
           user actually came for. Permanent because the host manages its own
           uninstall entry and its service must survive an Umbra client upgrade. -->
      <?ifndef env.UMBRA_SKIP_HOST ?>
      <ExePackage Id="UmbraHost"
                  Cache="remove"
                  PerMachine="yes"
                  Permanent="yes"
                  Vital="no"
                  DisplayName="Umbra Host"
                  InstallCondition="InstallHostCheckbox = 1"
                  DetectCondition="HostAlreadyInstalled"
                  InstallArguments="/S">
        <ExePackagePayload Name="UmbraHostSetup.exe"
                           SourceFile="$(env.BUILD_ROOT)\host\UmbraHostSetup.exe" />

        <!-- Reboot requested: let Burn schedule it rather than treating it as failure -->
        <ExitCode Value="3010" Behavior="scheduleReboot" />
      </ExePackage>
      <?endif?>
    </Chain>

  </Bundle>
</Wix>
