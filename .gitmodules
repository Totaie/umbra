[submodule "moonlight-common-c/moonlight-common-c"]
	path = moonlight-common-c/moonlight-common-c
url=https://github.com/qiin2333/moonlight-common-c.git
[submodule "qmdnsengine/qmdnsengine"]
	path = qmdnsengine/qmdnsengine
	url = https://github.com/cgutman/qmdnsengine.git
[submodule "app/SDL_GameControllerDB"]
	path = app/SDL_GameControllerDB
	url = https://github.com/gabomdq/SDL_GameControllerDB.git
[submodule "third-party/AMF"]
	path = third-party/AMF
	url = https://github.com/GPUOpen-LibrariesAndSDKs/AMF.git

# Umbra Host (host/). update = none keeps a plain "git submodule update --init
# --recursive", and CI checkouts of the client, from fetching all of these:
# the host build fetches them itself (scripts\fetch-host-submodules.bat).
[submodule "host/packaging/linux/flatpak/deps/flatpak-builder-tools"]
	path = host/packaging/linux/flatpak/deps/flatpak-builder-tools
	url = https://github.com/flatpak/flatpak-builder-tools.git
	branch = master
	update = none
[submodule "host/packaging/linux/flatpak/deps/shared-modules"]
	path = host/packaging/linux/flatpak/deps/shared-modules
	url = https://github.com/flathub/shared-modules.git
	branch = master
	update = none
[submodule "host/third-party/build-deps"]
	path = host/third-party/build-deps
	url = https://github.com/LizardByte/build-deps.git
	branch = master
	update = none
[submodule "host/third-party/doxyconfig"]
	path = host/third-party/doxyconfig
	url = https://github.com/LizardByte/doxyconfig.git
	branch = master
	update = none
[submodule "host/third-party/glad"]
	path = host/third-party/glad
	url = https://github.com/Dav1dde/glad.git
	update = none
[submodule "host/third-party/googletest"]
	path = host/third-party/googletest
	url = https://github.com/google/googletest.git
	branch = main
	update = none
[submodule "host/third-party/inputtino"]
	path = host/third-party/inputtino
	url = https://github.com/games-on-whales/inputtino.git
	branch = stable
	update = none
[submodule "host/third-party/libdisplaydevice"]
